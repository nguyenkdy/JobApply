# VM local only. Create .env on the VM, never commit it.
# Replace all placeholders; use random hexadecimal values for URL-safe passwords.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
ACCOUNT_DB_PASSWORD=CHANGE_ME_ACCOUNT_DB_PASSWORD
JOB_DB_PASSWORD=CHANGE_ME_JOB_DB_PASSWORD
APPLICATION_DB_PASSWORD=CHANGE_ME_APPLICATION_DB_PASSWORD
# Shared signature key; at least 32 random characters. Never expose to frontend.
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Session duration in minutes.
TOKEN_MINUTES=120
# Bind web to the VM's network interfaces for access from the physical host.
# Firewall should allow this port only from the host or trusted local subnet.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
